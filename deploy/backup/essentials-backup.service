[Unit]
Description=ESSENTIALS encrypted off-site backup to IDrive e2
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/essentials-idrive-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Mail the admin when the job fails (see essentials-backup-alert.service).
OnFailure=essentials-backup-alert.service

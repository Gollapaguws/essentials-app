# phpList stack — copy to /opt/phplist/.env and fill every value.
# The file is outside git; keep it 0600.

PHPLIST_DATABASE_NAME=phplist
PHPLIST_DATABASE_USER=phplist
PHPLIST_DATABASE_PASSWORD=
PHPLIST_DATABASE_ROOT_PASSWORD=

# Signs phpList's cookies and one-time links. openssl rand -hex 32
PHPLIST_SECRET=

# Read once, on the first boot, to create the initial admin (login: admin).
ADMIN_NAME=ESSENTIALS
ADMIN_EMAIL=newsletters@essentialsedm.com
ADMIN_PASSWORD=

# Host Postfix relay (172.16.9.1 is the compose network gateway).
PHPLIST_SMTP_HOST=172.16.9.1
PHPLIST_SMTP_PORT=2525

# Campaign envelope/return path. Must be a local address on this mail server.
PHPLIST_BOUNCE_ADDRESS=bounce@essentialsedm.com

# Dedicated bounce mailbox, polled by `phplist -pprocessbounces` (cron, 03:00).
# Create the mailbox first: deploy/phplist/README.md, "Bounce mailbox".
PHPLIST_BOUNCE_IMAP_HOST=mail.essentialsedm.com
PHPLIST_BOUNCE_IMAP_USER=bounce@essentialsedm.com
PHPLIST_BOUNCE_IMAP_PASSWORD=
PHPLIST_BOUNCE_IMAP_PORT=993/imap/ssl

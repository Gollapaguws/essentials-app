{
  "name": "essentials",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:migrate": "npm run migrate --workspace @essentials/db",
    "db:seed": "npm run seed --workspace @essentials/db",
    "dev:api": "npm run dev --workspace @essentials/api",
    "dev:web": "npm run dev --workspace @essentials/web",
    "dev:mobile": "npm run dev --workspace @essentials/mobile",
    "build": "npm run build --workspaces --if-present",
    "proof:auth": "node scripts/auth-proof.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mfa": "node scripts/mfa-smoke.mjs",
    "uptime:watch": "node scripts/uptime-watch.mjs"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "qs": "6.17.1",
    "lodash": "4.18.1",
    "tar": "7.5.23",
    "tmp": "0.2.7",
    "postcss": "8.5.33",
    "ws": "8.23.0",
    "@xmldom/xmldom": "0.8.15",
    "fast-xml-parser": "5.12.1",
    "image-size": "2.1.0",
    "decode-uri-component": "0.5.1",
    "turbo-stream": "3.2.1",
    "picomatch@4": "4.0.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@nestjs/cli": {
      "glob": "14.0.6"
    },
    "@nestjs/platform-express": {
      "multer": "2.5.0",
      "body-parser": "1.20.9"
    },
    "express": {
      "body-parser": "1.20.9",
      "qs": "6.17.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "body-parser": "1.20.9",
    "qs": "6.17.1"
  }
}

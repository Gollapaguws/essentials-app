// ESSENTIALS — Prisma schema
// Phase 1 implemented; Phase 2-4 fields are present but UI/API is added later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  promoter
  guest
  artist
  venue_manager
}

enum VibeTag {
  Chill
  Party
  Networking
}

enum EventStatus {
  draft
  pending_venue_approval
  approved
  live
  completed
  cancelled
}

enum GuestListStatus {
  attending
  waitlisted
  checked_in
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
}

enum ConsentChannel {
  email
}

enum ConsentStatus {
  granted
  revoked
}

enum ArtistBookingStatus {
  pending
  confirmed
  /// The promoter confirmed the gig happened — the only state that may be invoiced.
  completed
  cancelled
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

enum PaymentStatus {
  pending
  paid
  failed
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  authUid           String?   @unique // Supabase auth.users.id (lazy-linked on first sign-in)
  name              String?
  avatar            String?
  role              Role      @default(guest)
  musicTastes       String[]  @default([]) // House, Techno, Hip-Hop, Afro, Amapiano
  vibeTag           VibeTag?
  verifiedBadge     Boolean   @default(false)
  // Set when the account appears, cleared once its owner chooses a password.
  mustResetPassword Boolean   @default(false)
  // Per-user Telegram DM target, bound by tapping a /start deep link once.
  telegramChatId    String?
  telegramLinkedAt  DateTime?
  telegramLinkCode  String?   @unique
  referralCode      String    @unique @default(cuid())
  referredById      String?
  referredBy        User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals         User[]    @relation("Referrals")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  managedVenues   Venue[]        @relation("VenueManagers")
  promotedEvents  Event[]        @relation("EventPromoter")
  guestLists      GuestList[]
  matches1        Match[]        @relation("MatchUser1")
  matches2        Match[]        @relation("MatchUser2")
  groupMessages   GroupMessage[]
  loyaltyVisits   LoyaltyVisit[]
  referralsGiven  Referral[]     @relation("Referrer")
  artistProfile   ArtistProfile?
  artistNotes     ArtistNote[]
  consentRecords  Consent[]
  emailEvents     EmailEvent[]

  @@index([role])
}

model Venue {
  id        String       @id @default(cuid())
  name      String
  address   String?
  lat       Float
  lng       Float
  capacity  Int
  amenities String[]     @default([])
  managerId String?
  manager   User?        @relation("VenueManagers", fields: [managerId], references: [id])
  events    Event[]
  // Phase 2: staff/door ops via DoorLog
  doorLogs  DoorLog[]
  invoices  Invoice[]
  createdAt DateTime     @default(now())

  @@index([managerId])
}

model Event {
  id                      String          @id @default(cuid())
  genres                  String[]        @default([])
  venueId                 String
  promoterId              String
  title                   String
  description             String?
  date                    DateTime
  lineup                  Json            @default("[]") // [{artistName, slot}]
  capacity                Int
  dressCode               String?
  ticketUrl               String?
  status                  EventStatus     @default(draft)
  revenueSplitPromoterPct Int             @default(50)
  /// What the promoter will pay a DJ per hour. Each slot pays rate × its length.
  djFeePerHour            Int             @default(0)
  /// Planning ceiling for the night's DJ spend; slots are priced off the rate.
  budget                  Int             @default(0)
  // The plan the slots were generated from, kept so the promoter can reopen and edit it.
  slotCount               Int?
  slotMinutes             Int?
  slotStartMinute         Int?
  venue                   Venue           @relation(fields: [venueId], references: [id])
  promoter                User            @relation("EventPromoter", fields: [promoterId], references: [id])
  guestLists              GuestList[]
  groupChat               EventGroupChat?
  campaigns               Campaign[]
  artistBookings          ArtistBooking[]
  slots                   EventSlot[]
  matches                 Match[]
  promotions              Promotion[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([venueId])
  @@index([promoterId])
  @@index([date, status])
}

model GuestList {
  id               String          @id @default(cuid())
  eventId          String
  userId           String
  status           GuestListStatus @default(attending)
  qrCode           String?         @unique // signed token, rendered as QR on door pass
  headcount        Int             @default(1)
  sourceCampaignId String?
  sourceCampaign   Campaign?       @relation(fields: [sourceCampaignId], references: [id])
  event            Event           @relation(fields: [eventId], references: [id])
  user             User            @relation(fields: [userId], references: [id])
  checkedInAt      DateTime?
  createdAt        DateTime        @default(now())

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model Match {
  id                    String @id @default(cuid())
  eventId               String
  user1Id               String
  user2Id               String
  sharedMusicTasteScore Int
  // Phase 2: smart matching UI + AI icebreakers
  event                 Event  @relation(fields: [eventId], references: [id])
  user1                 User   @relation("MatchUser1", fields: [user1Id], references: [id])
  user2                 User   @relation("MatchUser2", fields: [user2Id], references: [id])

  @@unique([eventId, user1Id, user2Id])
}

model EventGroupChat {
  id       String         @id @default(cuid())
  eventId  String         @unique
  messages GroupMessage[]
  event    Event          @relation(fields: [eventId], references: [id])
}

model GroupMessage {
  id           String         @id @default(cuid())
  chatId       String
  userId       String
  body         String
  // Phase 2: AI icebreakers flag
  isIcebreaker Boolean        @default(false)
  chat         EventGroupChat @relation(fields: [chatId], references: [id])
  user         User           @relation(fields: [userId], references: [id])
  createdAt    DateTime       @default(now())

  @@index([chatId, createdAt])
}

model LoyaltyVisit {
  id               String  @id @default(cuid())
  userId           String
  eventId          String
  visits           Int     @default(1) // running count snapshot
  freeEntryAwarded Boolean @default(false)
  user             User    @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  refereeEmail String
  refereeId    String?
  rewardType   String? // e.g. free_entry, bottle_discount
  rewardIssued Boolean  @default(false)
  referrer     User     @relation("Referrer", fields: [referrerId], references: [id])
  createdAt    DateTime @default(now())

  @@index([referrerId])
}

// ===== Email engine (Phase 1) =====
model Campaign {
  id            String         @id @default(cuid())
  name          String
  flow          String // welcome_series | weekly_drop | reminder_24h | reminder_1h | winback | one_off
  status        CampaignStatus @default(draft)
  segmentId     String?
  segment       EmailSegment?  @relation(fields: [segmentId], references: [id])
  eventId       String?
  event         Event?         @relation(fields: [eventId], references: [id])
  subject       String
  sentCount     Int            @default(0)
  createdAt     DateTime       @default(now())
  emailJobs     EmailJob[]
  guestLists    GuestList[]

  @@index([flow, status])
}

model EmailSegment {
  id        String     @id @default(cuid())
  name      String
  // JSON filter: {musicTastes:[], minAttendedEvents, vibeTag, ...}
  filter    Json       @default("{}")
  campaigns Campaign[]
  createdAt DateTime   @default(now())
}

model EmailJob {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  status     String   @default("queued") // queued | sent | failed | skipped
  error      String?
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  createdAt  DateTime @default(now())

  @@index([campaignId, status])
}

model EmailEvent {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  type      String // delivered | open | click | bounce | unsubscribe
  meta      Json     @default("{}")
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([email, type])
}

model Consent {
  id        String         @id @default(cuid())
  userId    String?
  email     String
  channel   ConsentChannel @default(email)
  status    ConsentStatus  @default(granted)
  source    String // signup | preference_center
  updatedAt DateTime       @updatedAt
  User      User?          @relation(fields: [userId], references: [id])

  @@unique([email, channel])
}

// ===== Phase 2: promotions engine =====
model Promotion {
  id          String                @id @default(cuid())
  eventId     String
  code        String                @unique
  kind        String                @default("discount") // discount | free_entry | bottle_upgrade
  discountPct Int                   @default(0)
  maxUses     Int                   @default(100)
  uses        Int                   @default(0)
  active      Boolean               @default(true)
  expiresAt   DateTime?
  event       Event                 @relation(fields: [eventId], references: [id])
  redemptions PromotionRedemption[]
  createdAt   DateTime              @default(now())

  @@index([eventId, active])
}

model PromotionRedemption {
  id          String    @id @default(cuid())
  promotionId String
  userId      String
  guestListId String?
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([promotionId, userId])
}

// ===== Artist portal (Phase 3 — SCHEMA ONLY) =====
model ArtistProfile {
  id                          String          @id @default(cuid())
  userId                      String          @unique
  stageName                   String
  bio                         String?
  imageUrl                    String?
  vehicleConsumptionLPer100km Float           @default(8)
  /// Platform-wide standard, set by admins only. DJs and promoters cannot edit it.
  travelRatePerKm             Float           @default(4.95)
  user                        User            @relation(fields: [userId], references: [id])
  bookings                    ArtistBooking[]
  invoices                    Invoice[]
  // Private promoter notes about this DJ; never shown to the DJ or other promoters.
  notes                       ArtistNote[]
  blackouts                   ArtistBlackout[]
}

/// A date the DJ cannot play. Applications on a blacked-out day are refused.
model ArtistBlackout {
  id        String         @id @default(cuid())
  artistId  String
  /// Midnight UTC at the start of the blocked day.
  date      DateTime
  reason    String?
  createdAt DateTime       @default(now())
  artist    ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, date])
  @@index([artistId, date])
}

/// A promoter's own running note on a DJ. One row per promoter/DJ pair.
model ArtistNote {
  id         String   @id @default(cuid())
  artistId   String
  promoterId String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  artist     ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  promoter   User          @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@unique([promoterId, artistId])
  @@index([artistId])
}

/// A bookable slice of one event: promoter-defined start, length and fee.
/// Created when the event is created (or re-planned), applied for by artists.
model EventSlot {
  id       String   @id @default(cuid())
  eventId  String
  startsAt DateTime
  endsAt   DateTime
  /// Display label, e.g. "20:00-21:00".
  label    String
  /// This slot's share of the event budget, in whole currency units.
  fee      Int      @default(0)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings ArtistBooking[]

  @@unique([eventId, startsAt])
  @@index([eventId])
}

model ArtistBooking {
  id                String              @id @default(cuid())
  /// Display label of the slot applied for (kept for bookings made before slots existed).
  slot              String?
  /// The bookable slot applied for. Null on legacy bookings.
  slotId            String?
  appliedAt         DateTime?
  eventId           String
  artistId          String
  startAt           DateTime
  endAt             DateTime
  setupBufferMin    Int                 @default(60)
  teardownBufferMin Int                 @default(45)
  performanceFee    Int                 @default(0)
  travelFee         Int                 @default(0)
  status            ArtistBookingStatus @default(pending)
  /// Set when the promoter confirms the gig was played; invoices require it.
  completedAt       DateTime?
  /// Why the promoter declined, sent to the DJ. Only set on a decline.
  declineReason     String?
  event             Event               @relation(fields: [eventId], references: [id])
  slotRef           EventSlot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)
  artist            ArtistProfile       @relation(fields: [artistId], references: [id])
  routeLegs         BookingRouteLeg[]
  invoice           Invoice?

  @@index([slotId])
}

model BookingRouteLeg {
  id                String        @id @default(cuid())
  bookingId         String
  distanceKm        Float
  durationMinutes   Int
  estimatedFuelCost Float
  isConflict        Boolean       @default(false)
  booking           ArtistBooking @relation(fields: [bookingId], references: [id])
}

model Invoice {
  id       String        @id @default(cuid())
  artistId String
  /// The completed gig this invoice bills for. One invoice per booking, so a
  /// gig can never be billed to the venue twice.
  bookingId String?      @unique
  /// Who pays: the venue the gig happened at.
  venueId   String?
  number   String        @unique
  status   InvoiceStatus @default(draft)
  total    Int           @default(0)
  artist   ArtistProfile @relation(fields: [artistId], references: [id])
  booking  ArtistBooking? @relation(fields: [bookingId], references: [id])
  venue    Venue?         @relation(fields: [venueId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  label     String
  amount    Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  status    PaymentStatus @default(pending)
  amount    Int
  provider  String? // payfast | stripe
  reference String?
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
}

// ===== Phase 2 hook: door operations =====
model DoorLog {
  id        String   @id @default(cuid())
  venue     Venue    @relation(fields: [venueId], references: [id])
  venueId   String
  eventId   String?
  scannedBy String
  qrToken   String
  result    String // ok | duplicate | invalid | capacity_full
  createdAt DateTime @default(now())

  @@index([venueId, createdAt])
}

// ===== Front-page content (admin editor) =====
model SiteVisit {
  id         String @id @default(cuid())
  visitorKey String
  path       String
  day        String
  views      Int    @default(1)

  @@unique([visitorKey, path, day])
  @@index([day])
}

// ===== Front-page content (admin editor) =====
model SiteContent {
  key       String   @id // "front_page"
  value     Json
  updatedAt DateTime @updatedAt
}

// ===== Auth audit (Supabase auth overhaul) =====
model AuthEvent {
  id        String   @id @default(cuid())
  kind      String // sign_in | lazy_link | role_change | mfa_enrolled | mfa_escalated
  userId    String?
  email     String?
  meta      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([userId])
  @@index([email])
}

// ===== Simulcast targets (YouTube, TikTok, Mixcloud, Facebook, Instagram, custom) =====
model StreamTarget {
  id        String   @id @default(cuid())
  platform  String // youtube | tiktok | mixcloud | facebook | instagram | custom
  label     String?
  url       String // full RTMP(S) push URL including stream key
  enabled   Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
}

// ===== Social media posting hub =====
model SocialPost {
  id          String    @id @default(cuid())
  content     String
  platforms   String[]
  mediaUrl    String?
  status      String    @default("draft") // draft | scheduled | publishing | published | partial | failed
  scheduledAt DateTime?
  results     Json      @default("{}") // { platform: { status, detail } }
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
}

// ===== DJ booking flow (event → notify artists → apply → confirm) =====
model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String // dj_call | application | confirmed | declined | generic
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// Live-room chat under the front-page stream. Anonymous display name, throttled
/// per IP at the API; the newest messages are the only ones the page reads.
model LiveChatMessage {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

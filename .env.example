# Database
DATABASE_URL="postgresql://essentials:essentials@localhost:5432/essentials?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth — Supabase (see docs/auth.md)
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""        # server only: role mirroring, never shipped to a client
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY=""
EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Door-pass HMAC key (independent of the session secret)
QR_SECRET="change-me-in-production"

# Unsubscribe-link HMAC key. Falls back to a key derived from QR_SECRET when unset.
EMAIL_UNSUBSCRIBE_SECRET=""

# Support chat (Jotform agent). Signs the signed-in user's id so the widget can
# trust the email it is given. Server-side only: never expose it to the browser.
JOTFORM_AGENT_SECRET=""

# App
APP_URL="http://localhost:3001"        # web dashboard
MOBILE_URL="essentials://"             # deep link base for auth callbacks

# Email (swappable provider: resend | console)
MAIL_PROVIDER="resend"
RESEND_API_KEY=""
MAIL_FROM="ESSENTIALS <hello@essentials.example>"

# Phase 3
FUEL_PRICE="23.5"  # currency per litre for fuel cost estimates

# Phase 4
PAYMENT_PROVIDER="sandbox"  # sandbox | stripe | payfast
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_SANDBOX="true"
CURRENCY="zar"
CORS_ORIGINS="http://localhost:3001"  # comma-separated; use * only in dev

# Deliverability (documented in docs/email-deliverability.md; set in your DNS provider)
# SPF:    v=spf1 include:resend.dev ~all
# DKIM:   provided by Resend (CNAME records per domain)
# DMARC:  _dmarc TXT "v=DMARC1; p=quarantine; rua=mailto:dmarc@essentials.example"

# Supabase local stack: supabase/config.toml references this via env() and the CLI
# substitutes it from .env. Set it there; never paste the value into config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# GoTrue's relay (host.docker.internal:25) needs no credentials, but the CLI
# rejects an empty literal, so these are referenced via env(). The CLI does not
# substitute empty values: after `supabase start`, clear GOTRUE_SMTP_USER and
# GOTRUE_SMTP_PASS in the auth container or GoTrue will try to authenticate.
SUPABASE_AUTH_SMTP_USER=
SUPABASE_AUTH_SMTP_PASS=

# Encrypts the Supabase tokens held by server-side dashboard sessions. Rotating
# it signs every dashboard user out; falls back to JWT_SECRET when unset.
SESSION_SECRET=

# Site (apps/site — Vite; these are baked at build time)
VITE_SUPABASE_URL=https://essentialsedm.com/supabase
VITE_SUPABASE_ANON_KEY=<same as SUPABASE_ANON_KEY>
VITE_API_URL=https://essentialsedm.com/api

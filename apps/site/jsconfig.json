{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom"
    ],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-dom",
      "vite/client"
    ]
  },
  "include": [
    "src/components/**/*.js",
    "src/pages/**/*.jsx",
    "src/lib/**/*.js",
    "src/lib/**/*.jsx",
    "src/App.jsx",
    "src/Layout.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/vite-plugins",
    "src/api",
    "src/components/ui"
  ]
}
